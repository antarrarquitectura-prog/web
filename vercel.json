{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/inicio",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/nosotros",
      "destination": "/#filosofia",
      "permanent": true
    },
    {
      "source": "/contacto",
      "destination": "/#contacto",
      "permanent": true
    },
    {
      "source": "/proyectos/residencial",
      "destination": "/proyectos#residencial",
      "permanent": true
    },
    {
      "source": "/proyectos/comercial",
      "destination": "/proyectos#comercial",
      "permanent": true
    },
    {
      "source": "/proyectos/interiores",
      "destination": "/proyectos#interiores",
      "permanent": true
    },
    {
      "source": "/proyectos/diseno-de-interiores",
      "destination": "/proyectos#interiores",
      "permanent": true
    },
    {
      "source": "/proyectos/dise%C3%B1o-de-interiores",
      "destination": "/proyectos#interiores",
      "permanent": true
    },
    {
      "source": "/proyectos/comercial/tienda-trend",
      "destination": "/proyectos#comercial",
      "permanent": true
    },
    {
      "source": "/proyectos/dise%C3%B1o-de-interiores/cocina-comedor",
      "destination": "/proyectos/int-cocina-comedor",
      "permanent": true
    },
    {
      "source": "/proyectos/diseno-de-interiores/cocina-comedor",
      "destination": "/proyectos/int-cocina-comedor",
      "permanent": true
    },
    {
      "source": "/proyectos/residencial/:slug",
      "destination": "/proyectos/:slug",
      "permanent": true
    },
    {
      "source": "/proyectos/comercial/:slug",
      "destination": "/proyectos/:slug",
      "permanent": true
    },
    {
      "source": "/proyectos/interiores/:slug",
      "destination": "/proyectos/:slug",
      "permanent": true
    },
    {
      "source": "/proyectos/diseno-de-interiores/:slug",
      "destination": "/proyectos/:slug",
      "permanent": true
    },
    {
      "source": "/proyectos/dise%C3%B1o-de-interiores/:slug",
      "destination": "/proyectos#interiores",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/textures/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
