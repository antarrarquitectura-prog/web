---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { SERVICES, GENERAL_SERVICE_FAQS } from '../../data/services';

const canonicalUrl = 'https://antarrarquitectos.com/servicios';
const pageTitle = 'Servicios de Arquitectura y Diseño en Chiclayo | Antarr Arquitectos';
const pageDescription =
  'Servicios de diseño residencial, multifamiliar, comercial y diseño de interiores en Chiclayo y la Costa Norte del Perú. Planos ejecutivos, 3D y asesoría.';

const catalogSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': 'https://antarrarquitectos.com/#organization',
      name: 'Antarr Arquitectos',
      url: 'https://antarrarquitectos.com',
      telephone: '+51926542501',
      email: 'info@antarrarquitectos.com',
      image: 'https://antarrarquitectos.com/assets/logo-antarr-dark.png',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Chiclayo',
        addressRegion: 'Lambayeque',
        addressCountry: 'PE'
      },
      areaServed: [
        { '@type': 'City', name: 'Chiclayo' },
        { '@type': 'AdministrativeArea', name: 'Lambayeque' },
        { '@type': 'Place', name: 'Costa Norte, Perú' }
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Servicios de Arquitectura y Diseño en Chiclayo',
        itemListElement: SERVICES.map((service) => ({
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: `${service.title} en Chiclayo`,
            description: service.seoDescription,
            url: `https://antarrarquitectos.com/servicios/${service.slug}`
          }
        }))
      }
    },
    {
      '@type': 'FAQPage',
      mainEntity: GENERAL_SERVICE_FAQS.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer
        }
      }))
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Inicio',
          item: 'https://antarrarquitectos.com/'
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Servicios',
          item: 'https://antarrarquitectos.com/servicios'
        }
      ]
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(catalogSchema)} />

  <div id="top" class="min-h-screen flex flex-col justify-between bg-transparent">
    <Navbar />

    <main class="flex-grow pt-28 sm:pt-32 pb-20 sm:pb-28 relative overflow-hidden">
      <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-10">
        <!-- Cabecera Editorial Hub -->
        <header class="max-w-4xl mx-auto text-center space-y-4 mb-14 sm:mb-16">
          <div class="badge-canteria mx-auto">
            <span class="w-1.5 h-1.5 bg-clay rounded-none"></span>
            <span class="font-tech text-xs tracking-widest uppercase font-bold">
              &middot; ESPECIALIDADES DEL ESTUDIO &middot; ANTARR ARQUITECTOS
            </span>
          </div>

          <h1 class="font-display text-3xl sm:text-5xl md:text-[3.25rem] font-light text-[#1C1917] leading-[1.15] tracking-tight">
            Acompañamos tu proyecto con <span class="font-serif italic font-normal text-[#8C5230]">criterio espacial y precisión técnica.</span>
          </h1>

          <div class="flex items-center justify-center gap-3 py-1">
            <div class="w-10 h-px bg-carbon/20"></div>
            <div class="w-1.5 h-1.5 rounded-none bg-ochre"></div>
            <div class="w-10 h-px bg-carbon/20"></div>
          </div>

          <p class="font-sans text-sm sm:text-[16px] leading-relaxed text-[#57504A] max-w-3xl mx-auto font-normal">
            Traducimos ideas y terrenos en arquitectura habitable, funcional y bien resuelta, integrando planos ejecutivos y visualización 3D para avanzar hacia la obra con total confianza.
          </p>
        </header>

        <!-- Grid 2 Columnas: 4 Especialidades en Bloques Monolíticos de Travertino Gris -->
        <section aria-label="Especialidades de arquitectura y diseño" class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 mb-16 sm:mb-20">
          {SERVICES.map((service) => (
            <article class="service-plaque relative overflow-hidden group flex flex-col justify-between p-7 sm:p-8 rounded-sm border border-stone-300/80 shadow-[0_6px_24px_rgba(28,25,23,0.06)] transition-all duration-300 hover:-translate-y-1">
              <div class="relative z-10 space-y-4">
                <div class="flex items-center justify-between border-b border-[#3C2D20]/15 pb-3">
                  <span class="font-display text-3xl sm:text-4xl font-light text-[#8C5230] select-none">
                    {service.number}
                  </span>
                </div>

                <div>
                  <span class="block font-tech text-[11px] tracking-widest uppercase text-olive-dark font-bold mb-1">
                    {service.subtitle}
                  </span>
                  <h2 class="font-display text-2xl sm:text-3xl text-[#1C1917] font-normal tracking-tight group-hover:text-[#8C5230] transition-colors">
                    <a href={`/servicios/${service.slug}`} class="focus:outline-none">
                      {service.title}
                    </a>
                  </h2>
                </div>

                <p class="font-sans text-sm leading-relaxed text-[#2C2825] font-normal">
                  {service.excerpt}
                </p>

                <ul class="space-y-1.5 pt-2 border-t border-[#3C2D20]/12">
                  {service.deliverables.slice(0, 3).map((item) => (
                    <li class="flex items-start gap-2 font-sans text-xs text-[#423B35] font-medium">
                      <span class="w-1.5 h-1.5 bg-[#8C5230] mt-1.5 shrink-0"></span>
                      <span>{item.title}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="relative z-10 pt-6 mt-6 border-t border-[#3C2D20]/15 flex items-center justify-between gap-4">
                <a
                  href={`/servicios/${service.slug}`}
                  class="inline-flex items-center gap-2 font-tech text-xs tracking-widest uppercase font-bold text-[#8C5230] hover:text-[#6e381e] transition-colors"
                >
                  <span>Explorar Servicio</span>
                  <span class="transform group-hover:translate-x-1 transition-transform">&rarr;</span>
                </a>

                <a
                  href={`/?servicio=${service.slug}#contacto`}
                  class="font-tech text-[11px] tracking-wider uppercase text-[#4A3E31] hover:text-[#1C1917] font-semibold transition-colors"
                >
                  Cotizar &rsaquo;
                </a>
              </div>
            </article>
          ))}
        </section>

        <!-- Sección de Preguntas Frecuentes (FAQPage Schema) -->
        <section aria-labelledby="faq-heading" class="max-w-4xl mx-auto mb-16 sm:mb-20 space-y-6">
          <div class="text-center space-y-2">
            <span class="font-tech text-[11px] tracking-widest uppercase text-olive font-bold block">
              Consultas Frecuentes
            </span>
            <h2 id="faq-heading" class="font-display text-2xl sm:text-3xl text-carbon font-light tracking-tight">
              Preguntas sobre nuestros <span class="font-serif italic text-[#8C5230]">servicios profesionales</span>
            </h2>
          </div>

          <div class="space-y-3">
            {GENERAL_SERVICE_FAQS.map((faq, idx) => (
              <details
                class="group rounded-[3px] bg-[#EAE3D8]/90 border-t border-white border-b border-[#3C2D20]/20 shadow-sm"
                open={idx === 0}
              >
                <summary class="flex items-center justify-between gap-4 px-5 sm:px-6 py-4 cursor-pointer list-none font-display text-base sm:text-lg text-carbon font-medium select-none">
                  <span>{faq.question}</span>
                  <span class="text-[#8C5230] font-mono text-xl leading-none transition-transform duration-200 group-open:rotate-45 shrink-0">
                    +
                  </span>
                </summary>
                <div class="px-5 sm:px-6 pb-5 pt-1 font-sans text-sm leading-relaxed text-[#2C2825] border-t border-[#3C2D20]/10">
                  {faq.answer}
                </div>
              </details>
            ))}
          </div>
        </section>

        <!-- Franja Inferior de Conversión con Textura Madera Caoba al Natural -->
        <section class="cta-caoba relative overflow-hidden p-7 sm:p-10 rounded-sm border border-amber-900/40 shadow-[0_12px_32px_rgba(18,10,6,0.22)] flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
          <div class="relative z-10 space-y-2 max-w-2xl">
            <div class="flex items-center gap-2 drop-shadow-[0_1px_2px_rgba(0,0,0,0.45)]">
              <span class="w-2 h-2 rounded-none bg-[#F5EBE0]"></span>
              <span class="font-tech text-[11px] uppercase tracking-widest text-[#F5EBE0] font-bold">
                &middot; ASESORÍA PROYECTUAL &middot; ANTARR ARQUITECTOS
              </span>
            </div>
            <h2 class="font-display text-2xl sm:text-3xl font-light text-[#FFFFFF] tracking-tight drop-shadow-[0_1px_3px_rgba(0,0,0,0.5)]">
              ¿Listo para concebir tu próximo <span class="font-serif italic font-normal text-[#FBE4C6]">proyecto?</span>
            </h2>
            <p class="font-sans text-xs sm:text-sm text-[#FAF6F0] leading-relaxed font-normal drop-shadow-[0_1px_2px_rgba(0,0,0,0.45)]">
              Agenda una evaluación inicial con nuestro equipo directivo y recibe una propuesta de alcance técnico acorde a tu terreno o inmueble.
            </p>
          </div>

          <div class="relative z-10 flex flex-col sm:flex-row items-center gap-4 w-full lg:w-auto shrink-0">
            <a
              href="https://wa.me/51926542501?text=Hola%20Antarr%20Arquitectos,%20quiero%20consultar%20por%20sus%20servicios%20de%20arquitectura."
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-6 py-3 font-tech text-xs tracking-widest uppercase font-bold cursor-pointer w-full sm:w-auto whitespace-nowrap bg-[#1C1917] hover:bg-[#292524] text-white border border-white/25 rounded-[2px] transition-colors shadow-sm"
            >
              <span>Consultar por WhatsApp</span>
              <span>&rarr;</span>
            </a>

            <a
              href="/#contacto"
              class="inline-flex items-center justify-center px-6 py-3 font-tech text-xs tracking-wider uppercase w-full sm:w-auto whitespace-nowrap bg-[#1C1917]/55 hover:bg-[#1C1917]/80 border border-white/80 text-white rounded-[2px] transition-colors font-semibold"
            >
              Ir al Formulario
            </a>
          </div>
        </section>
      </div>
    </main>

    <Footer />
  </div>
</Layout>

<style>
  .service-plaque {
    position: relative;
    overflow: hidden;
    background-color: #EAE6DF;
    border-top-color: rgba(255, 255, 255, 0.85);
    border-bottom-color: rgba(60, 45, 30, 0.22);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.72),
      0 6px 24px rgba(28, 25, 23, 0.06);
  }

  .service-plaque::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: url('/textures/travertino-gris.jpg');
    background-size: cover;
    background-repeat: no-repeat;
    pointer-events: none;
  }

  .service-plaque::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(rgba(247, 244, 239, 0.18), rgba(247, 244, 239, 0.24));
    pointer-events: none;
  }

  .service-plaque:nth-child(1)::before {
    background-position: 15% 12%;
    background-size: 135%;
  }

  .service-plaque:nth-child(2)::before {
    background-position: 82% 48%;
    background-size: 145%;
    transform: scaleX(-1);
  }

  .service-plaque:nth-child(3)::before {
    background-position: 28% 85%;
    background-size: 140%;
    transform: scaleY(-1);
  }

  .service-plaque:nth-child(4)::before {
    background-position: 75% 22%;
    background-size: 150%;
    transform: scale(-1, -1);
  }

  .service-plaque:hover {
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.88),
      0 12px 28px -4px rgba(28, 25, 23, 0.12),
      0 20px 36px -8px rgba(28, 25, 23, 0.08);
  }

  .cta-caoba {
    position: relative;
    overflow: hidden;
    background-color: #6B4930;
    background-image: url('/textures/madera-caoba.jpg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  summary::-webkit-details-marker {
    display: none;
  }
</style>
