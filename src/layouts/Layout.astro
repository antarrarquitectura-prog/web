---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  robots?: string;
  preloadHero?: boolean;
}

const SITE_URL = 'https://www.antarrarquitectos.com';

const {
  title = "Estudio de Arquitectura y Diseño de Interiores | Antarr Arquitectos",
  description = "Estudio de arquitectura y diseño de interiores en Chiclayo y todo el Perú. Arquitectos especialistas en casas, locales comerciales, planos ejecutivos y 3D.",
  canonical,
  ogImage = `${SITE_URL}/assets/projects/res-2-casa-valencia-1.webp`,
  ogImageAlt = "Antarr Arquitectos - Estudio de arquitectura y diseño de interiores en Perú",
  robots = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1",
  preloadHero = false
} = Astro.props;

const cleanPath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '');
const canonicalUrl = canonical || `${SITE_URL}${cleanPath}`;

const globalSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["ArchitecturalFirm", "LocalBusiness"],
      "@id": `${SITE_URL}/#organization`,
      "name": "Antarr Arquitectos",
      "alternateName": "Antarr Estudio de Arquitectura y Diseño de Interiores",
      "description": "Estudio de arquitectura y diseño de interiores en Chiclayo, Pimentel y todo el Perú. Especialistas en arquitectura residencial, edificios multifamiliares, diseño comercial e interiorismo a medida.",
      "url": SITE_URL,
      "telephone": "+51926542501",
      "email": "info@antarrarquitectos.com",
      "logo": {
        "@type": "ImageObject",
        "url": `${SITE_URL}/assets/logo-antarr-dark.png`
      },
      "image": [
        `${SITE_URL}/assets/projects/res-2-casa-valencia-1.webp`,
        `${SITE_URL}/assets/logo-antarr-dark.png`
      ],
      "sameAs": [
        "https://www.instagram.com/antarr_arquitectos/",
        "https://www.facebook.com/AntarrArquitectos/",
        "https://www.tiktok.com/@antarr_arquitectos",
        "https://www.linkedin.com/company/antarr-estudio-arquitect%C3%B3nico/"
      ],
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Carretera a Pimentel Km 6.2",
        "addressLocality": "Pimentel, Chiclayo",
        "addressRegion": "Lambayeque",
        "postalCode": "14001",
        "addressCountry": "PE"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -6.7985,
        "longitude": -79.8862
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "08:30",
          "closes": "18:30"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Saturday"],
          "opens": "09:00",
          "closes": "13:00"
        }
      ],
      "areaServed": [
        { "@type": "City", "name": "Chiclayo" },
        { "@type": "City", "name": "Pimentel" },
        { "@type": "AdministrativeArea", "name": "Lambayeque" },
        { "@type": "AdministrativeArea", "name": "La Libertad" },
        { "@type": "AdministrativeArea", "name": "Piura" },
        { "@type": "AdministrativeArea", "name": "Cajamarca" },
        { "@type": "AdministrativeArea", "name": "Tumbes" },
        { "@type": "AdministrativeArea", "name": "Amazonas" },
        { "@type": "City", "name": "Lima" },
        { "@type": "Country", "name": "Perú" }
      ],
      "knowsAbout": [
        "Estudio de Arquitectura",
        "Arquitectos en Perú",
        "Arquitectura Residencial Unifamiliar",
        "Edificios Multifamiliares",
        "Arquitectura y Diseño Comercial",
        "Diseño de Interiores",
        "Interiorismo Residencial y Comercial",
        "Arquitectura Bioclimática",
        "Planos Arquitectónicos y Ejecutivos",
        "Modelado 3D y Renders Fotorrealistas"
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Servicios de Arquitectura y Diseño de Interiores",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Diseño Residencial y Arquitectura de Casas",
              "url": `${SITE_URL}/servicios/diseno-residencial`
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Diseño Multifamiliar y Edificios",
              "url": `${SITE_URL}/servicios/diseno-multifamiliar`
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Arquitectura y Diseño Comercial",
              "url": `${SITE_URL}/servicios/diseno-comercial`
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Diseño de Interiores",
              "url": `${SITE_URL}/servicios/diseno-de-interiores`
            }
          }
        ]
      },
      "priceRange": "$$$"
    },
    {
      "@type": "WebSite",
      "@id": `${SITE_URL}/#website`,
      "url": `${SITE_URL}/`,
      "name": "Antarr Arquitectos",
      "alternateName": "Antarr Estudio de Arquitectura",
      "inLanguage": "es-PE",
      "publisher": {
        "@id": `${SITE_URL}/#organization`
      }
    }
