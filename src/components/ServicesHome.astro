---
// ServicesHome.astro - Retícula 2x2 de Placas Monolíticas en Travertino Gris (homóloga a /servicios)
import { SERVICES } from '../data/services';
---

<section
  id="especialidades"
  class="scroll-mt-20 w-full py-14 sm:py-16 lg:py-20 border-b border-hairline relative bg-transparent overflow-hidden"
>
  <div class="relative z-10 w-full max-w-7xl mx-auto px-6 md:px-10">
    <!-- Cabecera Editorial de Portada -->
    <header class="max-w-4xl mx-auto text-center space-y-3 mb-12 lg:mb-14">
      <div class="badge-canteria mx-auto">
        <span class="w-1.5 h-1.5 bg-clay rounded-none"></span>
        <span class="font-tech text-[11px] tracking-widest uppercase font-bold">
          &middot; 03 &mdash; ESPECIALIDADES DEL ESTUDIO &middot; ANTARR ARQUITECTOS
        </span>
      </div>

      <h2
        class="text-2xl sm:text-3xl md:text-[2.35rem] font-display font-light text-[#1C1917] leading-snug tracking-tight text-center mx-auto max-w-4xl"
        style="font-weight: 300 !important;"
      >
        Arquitectura y diseño con{' '}
        <span class="font-serif italic font-normal text-[#8C5230]">rigor técnico en cada escala.</span>
      </h2>

      <!-- Divisor Arquitectónico Editorial -->
      <div class="flex items-center justify-center gap-3 py-0.5">
        <div class="w-10 h-px bg-carbon/20"></div>
        <div class="w-1.5 h-1.5 rounded-none bg-ochre"></div>
        <div class="w-10 h-px bg-carbon/20"></div>
      </div>

      <p
        class="text-xs sm:text-sm max-w-3xl leading-relaxed text-center mx-auto font-normal"
        style="color: #2D2B28 !important; opacity: 1 !important;"
      >
        Traducimos ideas y terrenos en arquitectura habitable, funcional y bien resuelta, integrando planos ejecutivos y visualización 3D para avanzar hacia la obra con total confianza.
      </p>
    </header>

    <!-- Retícula Simétrica 2x2 de Placas en Travertino Gris -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 max-w-6xl mx-auto">
      {SERVICES.map((service) => (
        <article class="service-home-plaque relative overflow-hidden group flex flex-col p-7 sm:p-8 rounded-sm border border-stone-300/80 shadow-[0_6px_24px_rgba(28,25,23,0.06)] transition-all duration-300 hover:-translate-y-1">
          <div class="relative z-10 flex flex-col flex-1">
            <div class="border-b border-[#3C2D20]/15 pb-3 mb-5">
              <span class="font-serif text-3xl lg:text-4xl text-[#8C5230] font-light select-none block leading-none">
                {service.number}
              </span>
            </div>

            <span class="block font-tech text-[11px] tracking-[0.16em] uppercase text-[#78716C] font-semibold mb-1.5">
              {service.subtitle}
            </span>

            <h3 class="font-display text-2xl lg:text-[26px] font-normal text-[#1C1917] tracking-tight leading-snug mb-3.5 group-hover:text-[#8C5230] transition-colors">
              <a href={`/servicios/${service.slug}`} class="focus:outline-none">
                {service.title}
              </a>
            </h3>

            <p class="font-sans text-sm lg:text-[15px] text-[#44403C] leading-relaxed mb-6 font-normal">
              {service.excerpt}
            </p>

            <ul class="space-y-2 mb-8 pt-3 border-t border-[#3C2D20]/12 text-xs lg:text-[13px] text-[#292524]">
              {service.deliverables.slice(0, 3).map((item) => (
                <li class="flex items-start gap-2.5 font-sans font-medium leading-snug">
                  <span class="w-1.5 h-1.5 bg-[#8C5230] mt-1.5 shrink-0" aria-hidden="true"></span>
                  <span>{item.title}</span>
                </li>
              ))}
            </ul>

            <div class="border-t border-stone-400/30 pt-4 mt-auto flex items-center justify-between gap-4">
              <a
                href={`/servicios/${service.slug}`}
                class="inline-flex items-center gap-2 font-tech text-xs tracking-widest uppercase font-bold text-[#8C5230] hover:text-[#6e381e] transition-colors"
              >
                <span>Explorar Servicio</span>
                <span class="transform group-hover:translate-x-1 transition-transform" aria-hidden="true">&rarr;</span>
              </a>

              <a
                href={`/#contacto?servicio=${service.slug}`}
                class="font-tech text-[11px] tracking-wider uppercase text-[#57534E] hover:text-[#1C1917] font-semibold transition-colors"
              >
                Cotizar &rsaquo;
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Enlace inferior discreto al Hub de Servicios -->
    <div class="mt-10 text-center">
      <a
        href="/servicios"
        class="inline-flex items-center gap-2 font-tech text-xs tracking-[0.16em] uppercase font-medium text-[#44403C] hover:text-[#8C5230] transition-colors group"
      >
        <span>Ver alcance completo y preguntas frecuentes</span>
        <span class="text-[#8C5230] transform group-hover:translate-x-1 transition-transform" aria-hidden="true">
          &rarr;
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .service-home-plaque {
    position: relative;
    overflow: hidden;
    background-color: #EAE6DF;
    border-top-color: rgba(255, 255, 255, 0.85);
    border-bottom-color: rgba(60, 45, 30, 0.22);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.72),
      0 6px 24px rgba(28, 25, 23, 0.06);
  }

  .service-home-plaque::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: url('/textures/travertino-gris.webp');
    background-repeat: no-repeat;
    pointer-events: none;
  }

  .service-home-plaque::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(rgba(247, 244, 239, 0.18), rgba(247, 244, 239, 0.24));
    pointer-events: none;
  }

  .service-home-plaque:nth-child(1)::before {
    background-position: 16% 14%;
    background-size: 106%;
  }

  .service-home-plaque:nth-child(2)::before {
    background-position: 82% 44%;
    background-size: 108%;
    transform: scaleX(-1);
  }

  .service-home-plaque:nth-child(3)::before {
    background-position: 28% 84%;
    background-size: 110%;
    transform: scaleY(-1);
  }

  .service-home-plaque:nth-child(4)::before {
    background-position: 74% 24%;
    background-size: 112%;
    transform: scale(-1, -1);
  }

  .service-home-plaque:hover {
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.88),
      0 12px 28px -4px rgba(28, 25, 23, 0.12),
      0 20px 36px -8px rgba(28, 25, 23, 0.08);
  }
</style>
