---
// Navbar.astro - Barra de Navegación Oficial Antarr (Dintel Monolítico de Travertino Claro)
---

<header id="main-header" class="fixed top-0 left-0 right-0 z-50 navbar-travertino-lintel transition-all duration-300">
  <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-10 h-20 flex items-center justify-between">
    <!-- Brand Logo: Official Studio Logo -->
    <a href="/" class="group flex items-center gap-3 focus:outline-none py-1">
      <img 
        src="/assets/logo-antarr-dark.webp" 
        alt="Antarr Arquitectos" 
        width="39"
        height="48"
        decoding="async"
        class="h-10 sm:h-12 w-auto object-contain transition-transform duration-300 group-hover:scale-105" 
      />
      <div class="hidden sm:flex flex-col">
        <span class="font-display text-2xl tracking-tight text-[#1F1A14] font-semibold">
          Antarr
        </span>
        <span class="font-tech text-[10px] tracking-technical uppercase text-[#864728] -mt-1 font-bold">
          Arquitectos
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links: 1. Filosofía | 2. Proyectos | 3. Servicios | 4. Metodología | 5. Nosotros | 6. Contacto -->
    <nav aria-label="Navegación principal" class="hidden md:flex items-center space-x-5 lg:space-x-7">
      <a href="/#filosofia" class="navbar-link font-tech text-xs md:text-sm tracking-wider uppercase">
        Filosofía
      </a>
      <a href="/proyectos" class="navbar-link font-tech text-xs md:text-sm tracking-wider uppercase">
        Proyectos
      </a>
      <a href="/servicios" class="navbar-link font-tech text-xs md:text-sm tracking-wider uppercase">
        Servicios
      </a>
      <a href="/#metodologia" class="navbar-link font-tech text-xs md:text-sm tracking-wider uppercase">
        Metodología
      </a>
      <a href="/#nosotros" class="navbar-link font-tech text-xs md:text-sm tracking-wider uppercase">
        Nosotros
      </a>
      <a href="/#contacto" class="navbar-link font-tech text-xs md:text-sm tracking-wider uppercase">
        Contacto
      </a>
    </nav>

    <!-- Header Action: Oriented to Design Consultation -->
    <div class="hidden sm:flex items-center space-x-4">
      <a 
        href="/#contacto" 
        class="btn-terracota inline-flex items-center justify-center px-5 py-2.5 font-tech text-xs md:text-sm tracking-wider uppercase font-medium cursor-pointer"
      >
        Cotizar Proyecto
      </a>
    </div>

    <!-- Mobile Hamburger Toggle -->
    <button 
      id="mobile-menu-btn"
      type="button" 
      class="md:hidden p-2 text-[#1F1A14] focus:outline-none"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
    </button>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden navbar-travertino-mobile px-6 py-6 space-y-4">
    <div class="relative z-10 flex flex-col space-y-3">
      <a href="/#filosofia" class="navbar-link mobile-nav-link font-tech text-sm uppercase tracking-wider py-1">
        01 &mdash; Filosofía
      </a>
      <a href="/proyectos" class="navbar-link mobile-nav-link font-tech text-sm uppercase tracking-wider py-1">
        02 &mdash; Proyectos
      </a>
      <a href="/servicios" class="navbar-link mobile-nav-link font-tech text-sm uppercase tracking-wider py-1">
        03 &mdash; Servicios
      </a>
      <a href="/#metodologia" class="navbar-link mobile-nav-link font-tech text-sm uppercase tracking-wider py-1">
        04 &mdash; Metodología
      </a>
      <a href="/#nosotros" class="navbar-link mobile-nav-link font-tech text-sm uppercase tracking-wider py-1">
        05 &mdash; Nosotros
      </a>
      <a href="/#contacto" class="navbar-link mobile-nav-link font-tech text-sm uppercase tracking-wider py-1">
        06 &mdash; Contacto
      </a>
    </div>

    <div class="relative z-10 pt-4 border-t border-[#78695a]/25 flex flex-col gap-3">
      <a 
        href="https://wa.me/51926542501?text=Hola%20Antarr%20Arquitectos,%20quiero%20cotizar%20un%20proyecto." 
        target="_blank"
        rel="noopener"
        class="btn-terracota w-full text-center py-2.5 font-tech text-xs tracking-wider uppercase font-medium cursor-pointer inline-flex items-center justify-center"
      >
        Chat Directo WhatsApp
      </a>
    </div>
  </div>
</header>

<style>
  .navbar-travertino-lintel {
    position: fixed;
    background-color: #E2D8C9;
    background-image: url('/assets/navbar-travertino.webp');
    background-size: 850px auto;
    background-repeat: repeat-x;
    background-position: center center;
    border-bottom: 1px solid rgba(120, 105, 90, 0.25);
    box-shadow: 0 8px 24px -2px rgba(25, 20, 15, 0.28);
  }

  .navbar-travertino-mobile {
    position: relative;
    background-color: #E2D8C9;
    background-image: url('/assets/navbar-travertino.webp');
    background-size: 850px auto;
    background-repeat: repeat-x;
    background-position: center center;
    border-bottom: 1px solid rgba(120, 105, 90, 0.25);
    box-shadow: 0 10px 20px -3px rgba(45, 38, 28, 0.12);
  }

  .navbar-link {
    color: #1F1A14 !important;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .navbar-link:hover {
    color: #864728 !important;
  }
</style>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const links = document.querySelectorAll('.mobile-nav-link');

  menuBtn?.addEventListener('click', () => {
    const isHidden = mobileMenu?.classList.toggle('hidden');
    menuBtn.setAttribute('aria-expanded', String(!isHidden));
  });

  links.forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      menuBtn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
