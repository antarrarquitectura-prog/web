---
// Methodology.astro - Flujo Proyectual Integral Multidisciplinario (Viewport Fit 100% & Diseño Orgánico)
const PHASES = [
  {
    step: "01",
    title: "Inmersión & Reconocimiento",
    titleLine1: "Inmersión &",
    titleLine2: "Reconocimiento",
    description: "Conversamos a fondo para entender cómo vives o cómo opera tu proyecto, reconociendo el lugar o el espacio existente para identificar su verdadero potencial antes de proyectar."
  },
  {
    step: "02",
    title: "Concepto & Espacio",
    titleLine1: "Concepto &",
    titleLine2: "Espacio",
    description: "Aterrizamos las primeras propuestas para ordenar los ambientes y definir el carácter del proyecto, asegurando que cada metro cuadrado responda a tus expectativas e inversión."
  },
  {
    step: "03",
    title: "Forma & Materialidad",
    titleLine1: "Forma &",
    titleLine2: "Materialidad",
    description: "Le damos volumen al proyecto y exploramos texturas, iluminación y proporciones en tres dimensiones, para que experimentes cada espacio con certeza antes de construir."
  },
  {
    step: "04",
    title: "Desarrollo Técnico & Entrega",
    titleLine1: "Desarrollo Técnico",
    titleLine2: "& Entrega",
    description: "Elaboramos los planos ejecutivos y las especificaciones constructivas necesarias para que la obra se edifique con precisión, orden y fidelidad al diseño aprobado."
  }
];
---

<section 
  id="metodologia" 
  class="scroll-mt-20 w-full min-h-[calc(100vh-4.5rem)] flex flex-col justify-center py-8 lg:py-10 overflow-hidden relative bg-transparent border-b border-hairline"
>
  <!-- Elemento Botánico: Hojas 1 (Follaje en Margen Derecho según Canon Antarr) -->
  <div 
    class="absolute right-0 top-2.5 sm:top-3 md:top-3 lg:top-3 z-0 pointer-events-none select-none hojas-container translate-x-5 lg:translate-x-8 scale-95"
    aria-hidden="true"
  >
    <div class="hojas-hover-wrapper">
      <div class="hojas-breeze-inner">
        <img 
          src="/assets/hojas-1.webp" 
          alt="" 
          width="460"
          height="635"
          class="w-[150px] sm:w-[190px] md:w-[220px] lg:w-[260px] xl:w-[310px] h-auto object-contain block hojas-img"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>

  <!-- Ambient Light Orbs for Sculptural Flow -->
  <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-sand/20 blur-3xl pointer-events-none"></div>

  <div class="relative z-10 w-full max-w-7xl mx-auto px-6 md:px-10">
    
    <!-- Header Equilibrada, Centrada y con Transición Editorial -->
    <div class="max-w-4xl mx-auto text-center space-y-3 mb-6 lg:mb-8">
      <div class="badge-canteria text-center mx-auto">
        <span class="w-1.5 h-1.5 bg-clay rounded-none"></span>
        <span class="font-tech text-[11px] tracking-widest uppercase font-bold">
          • 04 &mdash; METODOLOGÍA PROYECTUAL &middot; ANTARR ARQUITECTOS
        </span>
      </div>

      <h2 class="text-2xl sm:text-3xl md:text-[2.2rem] font-display font-light text-carbon leading-snug tracking-tight text-center mx-auto max-w-4xl" style="font-weight: 300 !important;">
        <span class="font-serif italic text-[#864728]">Claridad conceptual</span>{' '}y <span class="font-serif italic text-[#864728]">control técnico</span>{' '}desde la primera idea hasta la obra.
      </h2>

      <!-- Divisor Arquitectónico Editorial (Línea + Punto + Línea) -->
      <div class="flex items-center justify-center gap-3 py-0.5">
        <div class="w-10 h-px bg-carbon/20"></div>
        <div class="w-1.5 h-1.5 rounded-none bg-ochre"></div>
        <div class="w-10 h-px bg-carbon/20"></div>
      </div>

      <p class="text-xs sm:text-sm max-w-3xl leading-relaxed text-center mx-auto font-normal" style="color: #2D2B28 !important; opacity: 1 !important;">
        Un proceso ordenado y transparente para concebir arquitectura e interiorismo con identidad propia, certeza constructiva y optimización de recursos.
      </p>
    </div>

    <!-- Grid 4 Placas de Madera Roble Natural con Variación de Vetas y Estilo Monolítico -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 md:gap-5 items-stretch">
      {PHASES.map((phase) => (
        <article
          class="madera-placa relative overflow-hidden group flex flex-col justify-start p-6 lg:p-7 rounded-sm border border-stone-400/40 shadow-[0_6px_24px_rgba(28,25,23,0.06)] transition-all duration-300 hover:-translate-y-1"
        >
          <div class="relative z-10 flex flex-col justify-start h-full space-y-3">
            <div class="border-b border-[#3C2D20]/15 pb-2.5">
              <span class="font-display text-3xl font-light text-[#8C5230] select-none block">
                {phase.step}
              </span>
            </div>

            <h3 class="font-display text-xl text-[#1C1917] font-normal tracking-tight leading-snug min-h-[3rem]">
              <span class="block">{phase.titleLine1}</span>
              <span class="block">{phase.titleLine2}</span>
            </h3>

            <p class="text-sm leading-relaxed text-[#2C2825] font-sans font-normal">
              {phase.description}
            </p>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>

<style>
  .madera-placa {
    position: relative;
    overflow: hidden;
    background-color: #D8C7B0;
    border-top-color: rgba(255, 255, 255, 0.72);
    border-bottom-color: rgba(60, 45, 30, 0.25);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.68),
      0 6px 24px rgba(28, 25, 23, 0.06);
  }
  .madera-placa::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: url('/assets/madera-roble.webp');
    background-size: cover;
    background-repeat: no-repeat;
    pointer-events: none;
  }
  .madera-placa::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(rgba(247, 244, 239, 0.24), rgba(247, 244, 239, 0.30));
    pointer-events: none;
  }
  .madera-placa:nth-child(1)::before {
    background-position: 15% 15%;
    background-size: 132%;
  }
  .madera-placa:nth-child(2)::before {
    background-position: 82% 45%;
    background-size: 140%;
    transform: scaleX(-1);
  }
  .madera-placa:nth-child(3)::before {
    background-position: 28% 82%;
    background-size: 138%;
    transform: scaleY(-1);
  }
  .madera-placa:nth-child(4)::before {
    background-position: 75% 24%;
    background-size: 145%;
    transform: scale(-1, -1);
  }
  .madera-placa:hover {
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.85),
      0 12px 28px -4px rgba(28, 25, 23, 0.12),
      0 20px 36px -8px rgba(28, 25, 23, 0.08);
  }

  /* ==========================================================================
     ANIMACIÓN BOTÁNICA SUSPENDIDA - HOJAS 1 (CUADRANTE SUPERIOR DERECHO)
     ========================================================================== */
  .hojas-container {
    transform-origin: 100% 0%;
    line-height: 0;
  }

  /* Capa 1: Respuesta al Cursor y Péndulo con Inercia Botánica */
  .hojas-hover-wrapper {
    display: block;
    transform-origin: 100% 0%;
    transition: transform 2.2s cubic-bezier(0.2, 1, 0.35, 1), filter 2.2s ease-out;
    will-change: transform, filter;
    pointer-events: auto;
  }

  /* Capa 2: Micro-loop Ambiental de Brisa Aérea Continua */
  .hojas-breeze-inner {
    display: block;
    transform-origin: 100% 0%;
    animation: brisa-aerea 12s ease-in-out infinite alternate;
    will-change: transform;
  }

  .hojas-img {
    display: block;
    transform-origin: 100% 0%;
    filter: drop-shadow(-15px 20px 25px rgba(0, 0, 0, 0.12));
    transition: filter 2.2s ease-out;
  }

  /* Micro-loop continuo de brisa aérea suave */
  @keyframes brisa-aerea {
    0% {
      transform: rotate(0deg) translateY(0);
    }
    50% {
      transform: rotate(-0.7deg) translateY(-2px);
    }
    100% {
      transform: rotate(0.5deg) translateY(2px);
    }
  }

  /* Respuesta progresiva al cursor (Desktop / Mouse) */
  @media (hover: hover) and (pointer: fine) {
    /* Nivel 1: Cursor sobre la sección Metodología */
    #metodologia:hover .hojas-hover-wrapper {
      transform: rotate(-1.2deg) translateY(-3px) translateX(2px);
    }

    #metodologia:hover .hojas-img {
      filter: drop-shadow(-16px 22px 27px rgba(0, 0, 0, 0.14));
    }

    /* Nivel 2: Cursor directamente sobre las hojas */
    #metodologia .hojas-hover-wrapper:hover {
      transform: rotate(-2.0deg) translateY(-5px) translateX(4px);
    }

    #metodologia .hojas-hover-wrapper:hover .hojas-img {
      filter: drop-shadow(-18px 24px 30px rgba(0, 0, 0, 0.16));
    }
  }

  /* Dispositivos móviles y pantallas táctiles: loop continuo sin hover */
  @media (hover: none) {
    .hojas-hover-wrapper {
      transition: none !important;
      transform: none !important;
    }
  }

  /* Reducción de movimiento */
  @media (prefers-reduced-motion: reduce) {
    .hojas-breeze-inner {
      animation: none !important;
    }
    .hojas-hover-wrapper {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
