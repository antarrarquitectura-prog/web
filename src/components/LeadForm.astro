---
// LeadForm.astro - Sección de Diagnóstico y Formulario de Calificación Técnica
---

<!-- Banner Intermedio de Llamado a la Acción (CTA Preliminar Desacoplado de la Sección Diagnóstico) -->
<aside class="w-full relative py-10 md:py-12 border-b border-hairline bg-transparent overflow-hidden">
  <div class="relative z-10 w-full max-w-7xl mx-auto px-6 md:px-10">
    <div class="cta-marmol-verde relative overflow-hidden p-6 sm:p-8 md:p-10 text-base">
      
      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
        
        <div class="lg:col-span-8 space-y-3">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-[2px] bg-black/25 backdrop-blur-[2px] border border-white/20 text-[#E8EFE9] text-xs font-medium tracking-widest uppercase font-tech">
            <span class="w-1.5 h-1.5 bg-clay rounded-none"></span>
            <span>Contacto Preliminar &middot; Antarr</span>
          </div>

          <h3 class="font-display text-xl sm:text-2xl md:text-3xl font-normal leading-snug tracking-tight text-[#FFFFFF] drop-shadow-[0_1px_2px_rgba(0,0,0,0.6)]">
            ¿Tienes una idea, un terreno o un espacio por transformar?
          </h3>

          <p class="font-sans text-xs sm:text-sm text-[#E8EFE9] font-normal leading-relaxed max-w-2xl drop-shadow-[0_1px_1px_rgba(0,0,0,0.4)]">
            Ya sea una residencia de campo, un local comercial o una intervención integral de interiores, analizamos la viabilidad espacial, normativa y conceptual de tu proyecto sin compromiso inicial.
          </p>
        </div>

        <div class="lg:col-span-4 flex flex-col sm:flex-row lg:flex-col gap-3 justify-center">
          <a 
            href="/#contacto" 
            class="btn-terracota inline-flex items-center justify-center gap-2 px-6 py-3.5 font-tech text-xs tracking-widest uppercase font-medium group text-center cursor-pointer"
          >
            <span>Iniciar Consulta Técnica</span>
            <span class="transform group-hover:translate-x-1 transition-transform">&rarr;</span>
          </a>

          <a 
            href="https://wa.me/51926542501?text=Hola%20Antarr%20Arquitectos,%20quiero%20hacer%20una%20consulta%20técnica%20sobre%20mi%20proyecto." 
            target="_blank"
            rel="noopener"
            class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-[#18231B]/80 hover:bg-[#18231B] text-white border border-white/20 font-tech text-xs tracking-widest uppercase font-medium rounded-[3px] transition-colors text-center cursor-pointer shadow-sm"
          >
            <span class="w-2 h-2 rounded-none bg-clay"></span>
            <span>Consulta Rápida por WhatsApp</span>
          </a>
        </div>

      </div>
    </div>
  </div>
</aside>

<!-- Sección Contacto / Diagnóstico Estrictamente Inicia en el Contenedor Claro con Textura Continua -->
<div id="contacto" style="scroll-margin-top: 80px;"></div>
<section 
  id="diagnostico" 
  style="scroll-margin-top: 80px;"
  class="w-full min-h-[calc(100vh-80px)] flex flex-col justify-center pt-12 md:pt-16 pb-20 md:pb-28 border-b border-hairline relative bg-transparent overflow-hidden"
>
  <div class="relative z-10 w-full max-w-7xl mx-auto px-6 md:px-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-stretch">
      
      <!-- Left Column: Editorial Contact Details & WhatsApp Direct Access (flex flex-col justify-between h-full) -->
      <div class="lg:col-span-5 flex flex-col justify-between h-full space-y-4">
        
        <div class="space-y-2">
          <div class="badge-canteria">
            <span class="w-1.5 h-1.5 bg-clay rounded-none"></span>
            <span class="font-tech text-xs tracking-widest uppercase font-bold">
              • 04 &mdash; CONTACTO & CONSULTA TÉCNICA
            </span>
          </div>
          <h2 class="font-display text-2xl sm:text-3xl md:text-4xl text-carbon leading-[1.08] font-light tracking-tight">
            Hablemos de tu próximo espacio.
          </h2>
          <p class="font-sans text-xs sm:text-sm leading-relaxed font-normal" style="color: #2D2B28 !important; opacity: 1 !important;">
            Completa los datos de tu proyecto para recibir una propuesta metodológica personalizada, o inicia una conversación directa con nosotros vía WhatsApp.
          </p>
        </div>

        <!-- Tarjeta de Contacto Compacta Translúcida (p-4 sm:p-5) -->
        <div class="p-4 sm:p-5 bg-[#F7F4EE] rounded-[3px] border-t border-white border-b border-[#3C2D20]/25 border-l border-white/50 border-r border-[#3C2D20]/15 space-y-2.5 shadow-[0_4px_6px_-1px_rgba(35,28,20,0.08),0_12px_24px_-4px_rgba(35,28,20,0.08)]">
          <div class="border-b border-carbon/10 pb-2">
            <span class="block font-tech text-[10px] tracking-widest uppercase text-olive font-semibold">Sede Principal</span>
            <span class="font-sans text-xs sm:text-sm text-carbon font-semibold">Chiclayo (Sede Central) &middot; Cobertura Norte y Nacional</span>
          </div>

          <div class="border-b border-carbon/10 pb-2">
            <span class="block font-tech text-[10px] tracking-widest uppercase text-olive font-semibold">Teléfono / WhatsApp Directo</span>
            <a href="tel:+51926542501" class="font-sans text-xs sm:text-sm text-carbon font-semibold hover:text-clay transition-colors">
              +51 926 542 501
            </a>
          </div>

          <div>
            <span class="block font-tech text-[10px] tracking-widest uppercase text-olive font-semibold">Correo Electrónico Proyectual</span>
            <a href="mailto:info@antarrarquitectos.com" class="font-sans text-xs sm:text-sm text-clay hover:underline font-semibold">
              info@antarrarquitectos.com
            </a>
          </div>
        </div>

        <!-- Direct WhatsApp Card Compacta (p-4 sm:p-5) -->
        <div class="p-4 sm:p-5 bg-gradient-to-br from-[#1E1914] to-[#14100D] text-[#F4F3EF] rounded-[3px] border-t border-white/20 border-b border-black/60 border-l border-white/10 border-r border-black/40 space-y-2.5 shadow-[0_4px_6px_-1px_rgba(20,15,10,0.25),0_16px_28px_-4px_rgba(20,15,10,0.30)]">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-none bg-clay"></span>
            <span class="font-tech text-xs uppercase tracking-widest text-[#F4F3EF] font-bold">
              Atención Inmediata por WhatsApp
            </span>
          </div>
          <p class="font-sans text-xs text-[#F4F3EF]/75 font-light leading-relaxed">
            Conversa directamente con el equipo de diseño para resolver dudas iniciales, compartir las características de tu terreno o coordinar una sesión de asesoría técnica.
          </p>
          <a 
            href="https://wa.me/51926542501?text=Hola%20Antarr%20Arquitectos,%20quiero%20coordinar%20una%20sesión%20de%20asesoría%20técnica." 
            target="_blank"
            rel="noopener"
            class="btn-terracota inline-flex items-center justify-center w-full py-2.5 font-tech text-xs tracking-widest uppercase font-bold gap-2 cursor-pointer"
          >
            <span>Iniciar Chat en WhatsApp &rarr;</span>
          </a>
        </div>

      </div>

      <!-- Right Column: Interactive Qualification Form Compacto Translúcido (p-5 md:p-6) -->
      <div class="lg:col-span-7 bg-[#F7F4EE] p-5 md:p-6 rounded-[3px] border-t border-white border-b border-[#3C2D20]/25 border-l border-white/50 border-r border-[#3C2D20]/15 shadow-[0_4px_6px_-1px_rgba(35,28,20,0.08),0_16px_32px_-4px_rgba(35,28,20,0.10)] flex flex-col justify-center">
        
        <form 
          id="qualification-form" 
          action="https://api.web3forms.com/submit" 
          method="POST" 
          class="space-y-3"
        >
          <!-- Web3Forms configuration targeting info@antarrarquitectos.com -->
          <input type="hidden" name="access_key" value="8f121d51-64d6-4447-9755-bb95d38f830c" />
          <input type="hidden" name="subject" value="Nueva Consulta de Proyecto - Antarr Arquitectos" />
          <input type="hidden" name="from_name" value="Web Antarr Arquitectos" />
          <input type="hidden" name="recipient" value="info@antarrarquitectos.com" />

          <!-- Row 1: Nombre y Teléfono (py-2 px-3 text-xs md:text-sm) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div class="space-y-0.5">
              <label for="lead-name" class="block font-tech text-[10px] tracking-widest uppercase text-carbon font-semibold">
                Nombre y Apellidos *
              </label>
              <input 
                type="text" 
                id="lead-name" 
                name="name" 
                required 
                placeholder="Ej. Carlos Mendoza" 
                class="w-full py-2 px-3 bg-[#f3ece2] border border-carbon/15 rounded-[2px] shadow-[inset_0_1px_2px_rgba(45,35,25,0.08)] font-sans text-xs md:text-sm text-carbon placeholder:text-carbon/40 focus:outline-none focus:border-clay focus:ring-1 focus:ring-clay transition-colors"
              />
            </div>

            <div class="space-y-0.5">
              <label for="lead-phone" class="block font-tech text-[10px] tracking-widest uppercase text-carbon font-semibold">
                Teléfono / WhatsApp *
              </label>
              <input 
                type="tel" 
                id="lead-phone" 
                name="phone" 
                required 
                placeholder="+51 900 000 000" 
                class="w-full py-2 px-3 bg-[#f3ece2] border border-carbon/15 rounded-[2px] shadow-[inset_0_1px_2px_rgba(45,35,25,0.08)] font-sans text-xs md:text-sm text-carbon placeholder:text-carbon/40 focus:outline-none focus:border-clay focus:ring-1 focus:ring-clay transition-colors"
              />
            </div>
          </div>

          <!-- Row 2: Correo Electrónico y Ubicación (py-2 px-3 text-xs md:text-sm) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div class="space-y-0.5">
              <label for="lead-email" class="block font-tech text-[10px] tracking-widest uppercase text-carbon font-semibold">
                Correo Electrónico *
              </label>
              <input 
                type="email" 
                id="lead-email" 
                name="email" 
                required 
                placeholder="carlos@ejemplo.com" 
                class="w-full py-2 px-3 bg-[#f3ece2] border border-carbon/15 rounded-[2px] shadow-[inset_0_1px_2px_rgba(45,35,25,0.08)] font-sans text-xs md:text-sm text-carbon placeholder:text-carbon/40 focus:outline-none focus:border-clay focus:ring-1 focus:ring-clay transition-colors"
              />
            </div>

            <div class="space-y-0.5">
              <label for="lead-location" class="block font-tech text-[10px] tracking-widest uppercase text-carbon font-semibold">
                Ubicación del Terreno o Inmueble *
              </label>
              <input 
                type="text" 
                id="lead-location" 
                name="project_location" 
                required 
                placeholder="Ej. Chiclayo, Piura, Trujillo, Cajamarca, Amazonas" 
                class="w-full py-2 px-3 bg-[#f3ece2] border border-carbon/15 rounded-[2px] shadow-[inset_0_1px_2px_rgba(45,35,25,0.08)] font-sans text-xs md:text-sm text-carbon placeholder:text-carbon/40 focus:outline-none focus:border-clay focus:ring-1 focus:ring-clay transition-colors"
              />
            </div>
          </div>

          <!-- Row 3: Selector Tipología de Proyecto en Fichas de Taller / Placas Matéricas -->
          <div class="space-y-1">
            <label class="block font-tech text-[10px] tracking-widest uppercase text-carbon font-semibold">
              Tipología de Proyecto *
            </label>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
              <label class="cursor-pointer">
                <input type="radio" name="project_type" value="Residencial" class="peer sr-only" checked />
                <div class="py-2 px-2.5 text-[11px] tracking-wider uppercase font-tech btn-terracota-chip text-center flex items-center justify-center font-medium">
                  Residencial
                </div>
              </label>

              <label class="cursor-pointer">
                <input type="radio" name="project_type" value="Multifamiliar" class="peer sr-only" />
                <div class="py-2 px-2.5 text-[11px] tracking-wider uppercase font-tech btn-terracota-chip text-center flex items-center justify-center font-medium">
                  Multifamiliar
                </div>
              </label>

              <label class="cursor-pointer">
                <input type="radio" name="project_type" value="Comercial" class="peer sr-only" />
                <div class="py-2 px-2.5 text-[11px] tracking-wider uppercase font-tech btn-terracota-chip text-center flex items-center justify-center font-medium">
                  Comercial
                </div>
              </label>

              <label class="cursor-pointer">
                <input type="radio" name="project_type" value="Interiores" class="peer sr-only" />
                <div class="py-2 px-2.5 text-[11px] tracking-wider uppercase font-tech btn-terracota-chip text-center flex items-center justify-center font-medium">
                  Interiores
                </div>
              </label>
            </div>
          </div>

          <!-- Row 4: Área Estimada (py-2 px-3 text-xs md:text-sm) -->
          <div class="space-y-0.5">
            <label for="lead-area" class="block font-tech text-[10px] tracking-widest uppercase text-carbon font-semibold">
              Área Estimada (M²)
            </label>
            <input 
              type="text" 
              id="lead-area" 
              name="estimated_area" 
              placeholder="Ej. 300 m² techados o de terreno" 
              class="w-full py-2 px-3 bg-[#f3ece2] border border-carbon/15 rounded-[2px] shadow-[inset_0_1px_2px_rgba(45,35,25,0.08)] font-sans text-xs md:text-sm text-carbon placeholder:text-carbon/40 focus:outline-none focus:border-clay focus:ring-1 focus:ring-clay transition-colors"
            />
          </div>

          <!-- Row 5: Detalles o Requerimientos Específicos (h-16 text-xs md:text-sm rows="2") -->
          <div class="space-y-0.5">
            <label for="lead-message" class="block font-tech text-[10px] tracking-widest uppercase text-carbon font-semibold">
              Detalles o Requerimientos Específicos
            </label>
            <textarea 
              id="lead-message" 
              name="message" 
              rows="2" 
              placeholder="Cuéntanos sobre tus prioridades: número de niveles, áreas sociales, materialidad deseada o plazos previstos..."
              class="w-full py-2 px-3 bg-[#f3ece2] border border-carbon/15 rounded-[2px] shadow-[inset_0_1px_2px_rgba(45,35,25,0.08)] font-sans text-xs md:text-sm text-carbon placeholder:text-carbon/40 focus:outline-none focus:border-clay focus:ring-1 focus:ring-clay transition-colors resize-none h-16"
            ></textarea>
          </div>

          <!-- Submit Button & Feedback Status (py-2.5 text-xs tracking-wider) -->
          <div class="pt-0.5">
            <button 
              type="submit" 
              id="submit-form-btn"
              class="btn-terracota w-full py-2.5 font-tech text-xs tracking-wider uppercase font-bold flex items-center justify-center gap-2 cursor-pointer"
            >
              <span>Enviar Consulta de Proyecto</span>
              <span>&rarr;</span>
            </button>
            <div id="form-feedback" class="hidden mt-2 p-2.5 rounded-[2px] text-center font-sans text-xs"></div>
          </div>

          <p class="font-sans text-[10px] text-carbon/60 text-center font-light">
            Al enviar este formulario, tu información técnica será revisada con estricta confidencialidad por el equipo directivo de Antarr Arquitectos.
          </p>

        </form>

      </div>

    </div>
  </div>
</section>

<script>
  const form = document.getElementById('qualification-form') as HTMLFormElement;
  const feedback = document.getElementById('form-feedback');
  const submitBtn = document.getElementById('submit-form-btn') as HTMLButtonElement;

  // Preselección automática desde parámetro ?servicio=[slug] en URL o hash
  const SERVICE_TO_RADIO: Record<string, string> = {
    'diseno-residencial': 'Residencial',
    'diseno-multifamiliar': 'Multifamiliar',
    'diseno-comercial': 'Comercial',
    'diseno-de-interiores': 'Interiores',
  };

  function preselectServiceFromUrl() {
    if (!form) return;
    let serviceSlug = new URLSearchParams(window.location.search).get('servicio');
    if (!serviceSlug && window.location.hash.includes('?')) {
      const hashQuery = window.location.hash.split('?')[1];
      serviceSlug = new URLSearchParams(hashQuery).get('servicio');
    }
    if (serviceSlug && SERVICE_TO_RADIO[serviceSlug]) {
      const targetRadio = form.querySelector<HTMLInputElement>(
        `input[name="project_type"][value="${SERVICE_TO_RADIO[serviceSlug]}"]`
      );
      if (targetRadio) {
        targetRadio.checked = true;
      }
    }
  }

  preselectServiceFromUrl();
  window.addEventListener('hashchange', preselectServiceFromUrl);

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submitBtn || !feedback) return;

    const originalBtnText = submitBtn.innerHTML;
    submitBtn.disabled = true;
    submitBtn.innerHTML = `<span>Procesando solicitud...</span>`;

    const formData = new FormData(form);

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: formData
      });
      const result = await response.json();

      if (result.success) {
        feedback.className = "mt-2 p-2.5 rounded-[2px] text-center font-sans text-xs bg-olive/20 text-carbon border border-olive/30 font-medium block";
        feedback.textContent = "¡Solicitud recibida con éxito! Nuestro equipo de arquitectura se pondrá en contacto contigo en breve.";
        form.reset();
      } else {
        throw new Error(result.message || "Error al procesar el formulario.");
      }
    } catch (err: any) {
      const name = (form.querySelector('[name="name"]') as HTMLInputElement)?.value || '';
      const phone = (form.querySelector('[name="phone"]') as HTMLInputElement)?.value || '';
      const projType = (form.querySelector('[name="project_type"]:checked') as HTMLInputElement)?.value || '';
      const location = (form.querySelector('[name="project_location"]') as HTMLInputElement)?.value || '';
      const area = (form.querySelector('[name="estimated_area"]') as HTMLInputElement)?.value || '';
      const message = (form.querySelector('[name="message"]') as HTMLTextAreaElement)?.value || '';

      const waMsg = encodeURIComponent(`Hola Antarr Arquitectos, envío mi solicitud de diagnóstico:\n• Nombre: ${name}\n• Teléfono: ${phone}\n• Tipo: ${projType}\n• Ubicación: ${location}\n• Área: ${area}\n• Detalles: ${message}`);
      const waUrl = `https://wa.me/51926542501?text=${waMsg}`;

      feedback.className = "mt-3 p-3.5 rounded-[2px] text-center font-sans text-xs bg-[#f4ebe1] text-carbon border border-clay/30 block space-y-2.5 shadow-sm";
      feedback.innerHTML = `
        <p class="font-medium text-carbon">Hubo un inconveniente al conectar con el servidor de correo. ¡No te preocupes! Puedes transferir tus datos directamente a nuestro WhatsApp oficial con 1 clic:</p>
        <a href="${waUrl}" target="_blank" rel="noopener noreferrer" class="btn-terracota inline-flex items-center justify-center gap-2 px-4 py-2 font-tech text-xs tracking-wider uppercase font-bold">
          <span>Enviar Solicitud por WhatsApp Directo &rarr;</span>
        </a>
      `;
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerHTML = originalBtnText;
    }
  });
</script>

<style>
  .cta-marmol-verde {
    background-color: #445849;
    background-image: url('/assets/marmol-verde-panoramico.webp');
    background-size: 100% 100%;
    background-position: center center;
    background-repeat: no-repeat;
    image-rendering: -webkit-optimize-contrast;
    border-radius: 4px;
    border-top: 1px solid rgba(255, 255, 255, 0.65);
    border-bottom: 1px solid rgba(20, 30, 20, 0.35);
    box-shadow: 
      inset 0 1px 0 rgba(255, 255, 255, 0.75),
      inset 0 -1.5px 1px rgba(25, 35, 25, 0.25),
      0 4px 6px -1px rgba(20, 30, 25, 0.22),
      0 14px 28px -4px rgba(20, 30, 25, 0.18),
      0 22px 38px -8px rgba(20, 30, 25, 0.10);
  }
</style>
